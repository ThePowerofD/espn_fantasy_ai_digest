# Copy to .env and fill in. .env is git-ignored and docker-ignored — never commit it.

# --- Required ---
# Numeric league id, from the ESPN league URL (?leagueId=...)
LEAGUE_ID=

# Private-league auth cookies. Get them from your browser's cookie storage
# for fantasy.espn.com while logged in. Treat both as passwords.
ESPN_S2=
# Include the surrounding curly braces, e.g. {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
SWID=

# --- Optional ---
# Season year. Default: current year.
SEASON=
# Fallback only; your team is normally auto-detected by matching SWID to owners.
TEAM_ID=
# IANA timezone used for every timestamp in the report.
TZ=America/Mexico_City
# Where the Markdown report is written inside the container.
OUTPUT_DIR=/app/output
